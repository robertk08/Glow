#pragma once
//  ============================================================================
//  secrets.h.example - copy to secrets.h and fill in. secrets.h is gitignored
//  and is the only file in this sketch that is not safe to commit.
//  ============================================================================
//
//  The ESP32-S3 has a 2.4GHz radio and nothing else. A 5GHz-only SSID will
//  never appear in a scan, however many times you retype the password; on a
//  dual-band router sharing one SSID the join works, because the AP picks the
//  band. If the node never joins, check the band before anything else.
//
//  WPA2-PSK. WPA3-only and enterprise networks are not handled here.
//
//  The SSID below is checked at boot: leave it at the placeholder and the
//  sketch treats the file as unfilled and says so, rather than spending
//  forever failing to join a network called "your-network".

#define WIFI_SSID     "your-network"
#define WIFI_PASSWORD "your-password"
